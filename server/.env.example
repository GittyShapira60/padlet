MONGODB_URI=mongodb://localhost:27017/padlet_dev
JWT_SECRET=change_me_to_a_long_random_string
PORT=3001
FRONTEND_URL=http://localhost:5173

# AWS S3 (file uploads). The bucket should be PRIVATE (block all public access) -
# images are served via short-lived signed URLs, not a public bucket policy.
AWS_REGION=us-east-1
AWS_S3_BUCKET=change_me_to_your_bucket_name
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
# Optional: how long (seconds) a signed image URL stays valid. Defaults to 3600.
AWS_S3_SIGNED_URL_EXPIRY=3600
